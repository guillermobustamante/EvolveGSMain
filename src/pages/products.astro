---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';

const products = [
  {
    name: 'Evolve Approval AI',
    tagline: 'Intelligent document approval, built on Microsoft 365.',
    description:
      'Our flagship product. Drop documents in SharePoint or email, and Approval AI extracts fields, classifies risk, routes to the right approvers, and surfaces exceptions for humans to decide.',
    features: [
      'AI intake and field extraction',
      'Policy-driven routing & SLA tracking',
      'Approval agents with human-in-the-loop',
      'Audit trail and compliance reporting',
    ],
    badge: 'Flagship',
  },
  {
    name: 'ARAS PLM Accelerator',
    tagline: 'Modernize product lifecycle management.',
    description:
      'A delivery accelerator for ARAS Innovator: data migration templates, change-process patterns, and Microsoft 365 integration so engineering, manufacturing, and quality teams share a single source of truth.',
    features: [
      'Pre-built migration templates',
      'Change & part management workflows',
      'Microsoft 365 / Teams integration',
      'Power BI reporting pack',
    ],
    badge: 'Manufacturing',
  },
  {
    name: 'Power Platform Starter Kit',
    tagline: 'Governance, ALM, and templates to scale Power Platform safely.',
    description:
      'Everything a Microsoft customer needs to launch a sustainable citizen-developer practice: CoE Starter Kit configured, ALM pipelines, environment strategy, and templated solutions.',
    features: [
      'CoE Starter Kit setup',
      'Pipeline & ALM templates',
      'Environment & DLP strategy',
      'Maker enablement curriculum',
    ],
    badge: 'Governance',
  },
  {
    name: 'Fabric Insight Pack',
    tagline: 'Pre-built semantic models for Microsoft 365 and Sales.',
    description:
      'Curated semantic models, verified answers, and Power BI templates for common Microsoft 365 usage, Dynamics 365 Sales, and finance dashboards — ready to plug into Microsoft Fabric.',
    features: [
      'Medallion data architecture',
      'Verified answers for Copilot',
      'Row-level security templates',
      'Executive Power BI dashboards',
    ],
    badge: 'Analytics',
  },
];
---
<BaseLayout title="Products — Evolve Global Solutions" description="Evolve Approval AI, ARAS PLM Accelerator, Power Platform Starter Kit, and Fabric Insight Pack.">
  <Hero
    eyebrow="Products"
    title="Solutions you can run, not just slideware."
    description="Microsoft-aligned accelerators and a flagship AI document approval product — productized so you go live faster and cheaper."
    primaryCta={{ href: '/contact', label: 'Request a demo' }}
  />

  <section class="section">
    <div class="container-page grid gap-6 md:grid-cols-2">
      {products.map((p) => (
        <article class="card p-8 flex flex-col">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-accent-600">{p.badge}</span>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-100">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2l9 5-9 5-9-5 9-5zm0 10l9 5-9 5-9-5"/></svg>
            </span>
          </div>
          <h3 class="h3 mt-4">{p.name}</h3>
          <p class="mt-1 text-sm font-medium text-brand-700">{p.tagline}</p>
          <p class="mt-3 text-ink-600 leading-relaxed">{p.description}</p>
          <ul class="mt-5 grid gap-2">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-ink-700">
                <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 flex-none text-accent-600" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-secondary mt-auto pt-6 self-start">Request a demo</a>
        </article>
      ))}
    </div>
  </section>

  <CTA title="Want a deeper walkthrough?" description="We can demo any of our products on a 30-minute call and share the implementation playbook." ctaLabel="Schedule a demo" />
</BaseLayout>
