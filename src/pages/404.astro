---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Evolve Global Solutions">
  <section class="container-page py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="h1 mt-4">We can't find that page.</h1>
    <p class="lead mt-4 max-w-xl mx-auto">The link may have moved or no longer exists. Try the homepage or get in touch — we're happy to point you in the right direction.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/contact" class="btn-secondary">Contact us</a>
    </div>
  </section>
</BaseLayout>
