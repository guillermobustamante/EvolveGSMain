---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/products', label: 'Products' },
  { href: '/partners', label: 'Partners' },
  { href: '/powerbi', label: 'Power BI' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b border-ink-200 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/75">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex items-center group" aria-label="Evolve Global Solutions — Home">
      <img
        src="/brand/evolve-lockup.png"
        alt="Evolve Global Solutions — We Provide Value"
        width="220"
        height="54"
        class="h-9 w-auto sm:h-10"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-3 py-2 text-sm font-bold transition-colors',
            isActive(item.href)
              ? 'bg-brand-50 text-brand-700'
              : 'text-ink-700 hover:bg-ink-50 hover:text-ink-900',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://www.evolvegs.com/login"
        class="hidden md:inline-flex btn-secondary"
        rel="noopener"
      >
        Client Login
      </a>
      <a href="/contact" class="hidden sm:inline-flex btn-primary">Get in touch</a>
      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-ink-700 hover:bg-ink-50"
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="lg:hidden hidden border-t border-ink-200 bg-white">
    <nav class="container-page py-3 flex flex-col gap-1" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-bold',
            isActive(item.href)
              ? 'bg-brand-50 text-brand-700'
              : 'text-ink-700 hover:bg-ink-50',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="https://www.evolvegs.com/login" class="rounded-lg px-3 py-2 text-sm font-bold text-ink-700 hover:bg-ink-50">Client Login</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }
</script>
