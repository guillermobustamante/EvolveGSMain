---
interface Props {
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const {
  title = 'Ready to evolve your business?',
  description = "Tell us what you're working on. We'll respond within one business day with concrete next steps.",
  ctaHref = '/contact',
  ctaLabel = 'Start the conversation',
} = Astro.props;
---
<section class="container-page my-20">
  <div class="relative overflow-hidden rounded-3xl bg-cta-gradient px-8 py-14 sm:px-14 sm:py-16 shadow-lifted">
    <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-accent-400/30 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
      <p class="mt-3 text-base text-white/85 sm:text-lg">{description}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={ctaHref} class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-medium text-brand-800 shadow-soft hover:bg-ink-50">
          {ctaLabel}
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="mailto:hi@evolvegs.com" class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-medium text-white ring-1 ring-inset ring-white/30 hover:bg-white/15">
          hi@evolvegs.com
        </a>
      </div>
    </div>
  </div>
</section>
