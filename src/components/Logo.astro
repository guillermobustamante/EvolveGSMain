---
interface Props { name: string; }
const { name } = Astro.props;
---
<div class="flex h-16 items-center justify-center rounded-2xl bg-white ring-1 ring-ink-200 px-6 text-ink-500 hover:ring-brand-200 hover:text-brand-800 transition-colors">
  <span class="text-sm font-semibold tracking-wide">{name}</span>
</div>
